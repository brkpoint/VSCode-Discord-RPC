{
    "name": "vscode-discord-rpc",
    "icon": "icon.png",
    "publisher": "brkpointdotorg",
    "displayName": "VSC-RPC",
    "description": "Simple, easy to use discord RPC with customization.",
    "repository": {
        "url": "https://github.com/brkpoint/VSCode-Discord-RPC"
    },
    "version": "2.2.0",
    "engines": {
        "vscode": "^1.92.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/main.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-discord-rpc.startRPC",
                "title": "VSC-Discord-RPC: Start RPC."
            },
            {
                "command": "vscode-discord-rpc.stopRPC",
                "title": "VSC-Discord-RPC: Stop RPC."
            },
            {
                "command": "vscode-discord-rpc.reloadRPC",
                "title": "VSC-Discord-RPC: Reload RPC."
            },
            {
                "command": "vscode-discord-rpc.clearAllCache",
                "title": "VSC-Discord-RPC: Clear all cache."
            },
            {
                "command": "vscode-discord-rpc.reportIssue",
                "title": "VSC-Discord-RPC: Report an issue..."
            }
        ],
        "menus": {
            "issue/reporter": [
                {
                    "command": "vscode-discord-rpc.reportIssue"
                }
            ]
        },
        "configuration": [
            {
                "title": "VSCode Discord RPC",
                "properties": {
                    "vscode-discord-rpc.showTime": {
                        "order": 0,
                        "type": "boolean",
                        "default": true,
                        "description": "Enable/Disable time elapsed."
                    },
                    "vscode-discord-rpc.updateTimeInterval": {
                        "order": 1,
                        "type": "number",
                        "default": 12,
                        "description": "Update time for interval in seconds."
                    },
                    "vscode-discord-rpc.editing.showLanguageIcons": {
                        "order": 2,
                        "type": "boolean",
                        "default": true,
                        "description": "Enable/Disable language icon of current file"
                    },
                    "vscode-discord-rpc.editing.details": {
                        "type": "string",
                        "default": "$(workspace)",
                        "description": "Details field for RPC."
                    },
                    "vscode-discord-rpc.editing.state": {
                        "type": "string",
                        "default": "$(fileName):$(line):$(col) - $(problems)",
                        "description": "State field for RPC."
                    },
                    "vscode-discord-rpc.editing.iconText": {
                        "type": "string",
                        "default": "Editing...",
                        "description": "Text when hovering over the icon."
                    },
                    "vscode-discord-rpc.idle.details": {
                        "type": "string",
                        "default": "Idle...",
                        "description": "Idle details field for RPC."
                    },
                    "vscode-discord-rpc.idle.state": {
                        "type": "string",
                        "default": "",
                        "description": "Idle state field for RPC."
                    },
                    "vscode-discord-rpc.idle.iconText": {
                        "type": "string",
                        "default": "Idling...",
                        "description": "Idle text when hovering over the icon."
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run prod",
        "prod": "npm run compileProd && npm run minify",
        "dev": "npm run compileDev",
        "watch": "npm run dev",
        "compileProd": "NODE_ENV=production webpack --mode production --devtool hidden-source-map",
        "compileDev": "NODE_ENV=development webpack --watch --mode development",
        "minify": "terser ./dist/main.js -o ./dist/main.min.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.14",
        "@types/vscode": "^1.92.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.4.1",
        "clean-webpack-plugin": "^4.0.0",
        "compression-webpack-plugin": "^11.1.0",
        "eslint": "^8.57.1",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.2",
        "typescript": "^5.7.3",
        "webpack": "^5.97.1",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "cross-spawn": "^7.0.6",
        "glob": "^11.0.1",
        "ws": "^8.18.0"
    }
}
